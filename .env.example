# PharmaSafe — Elasticsearch Configuration
# Copy this to .env and fill in your values. Never commit .env to git.

# ─── WHERE TO GET THESE ─────────────────────────────────────────────────────
# Elastic Cloud / Serverless:
#   1. Log in to https://cloud.elastic.co
#   2. Open your project (Elasticsearch Serverless or Hosted)
#   3. Click Help (?) → Connection Details
#   4. Copy "Elasticsearch endpoint" from the Endpoints tab
#
# API Key:
#   Serverless: Project home → Create API key (or Project settings → Management → API keys)
#   Hosted: Kibana global search → "API keys" → Create API key
#   Store the key securely — it's shown only once.
# ─────────────────────────────────────────────────────────────────────────────

# Elasticsearch endpoint (e.g. https://xxxxx.es.us-east-1.aws.elastic.cloud:443)
ES_ENDPOINT=

# API key (base64-encoded, from Create API key)
ES_API_KEY=

# Optional: Kibana URL (for Agent Builder UI — usually same base as ES, different path)
# Serverless: Use the Kibana URL from Connection Details
KIBANA_URL=
